#include <winver.h>

1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION @VERSION_NUMBERS@
  PRODUCTVERSION @VERSION_NUMBERS@
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Planify"
      VALUE "FileDescription", "Planify"
      VALUE "FileVersion", "@VERSION@"
      VALUE "LegalCopyright", "Alain M. and contributors. Licensed under the GPL-3.0."
      VALUE "ProductName", "Planify"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
